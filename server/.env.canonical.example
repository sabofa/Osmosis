# Canonical node — copy to /etc/osmosis/canonical.env on the server (deploy/install.sh
# does this and fills in MCP_AUTH_TOKEN). Every path is absolute on purpose: the
# systemd unit runs `node dist/index.js` with no shell, so nothing is relative to a cwd.
NODE_ROLE=canonical
NODE_LABEL=server
PORT=8081

# SQLite file and uploads. Both live under /var/lib/osmosis so a backup of that
# one directory captures the entire state of the deployment.
DB_PATH=/var/lib/osmosis/canonical.db
UPLOADS_DIR=/var/lib/osmosis/uploads

# Built web app, served by the same process at / — see server/src/http/app.ts.
WEB_DIST_DIR=/opt/osmosis/web/dist

# Shared secret in the /mcp/<token> URL. install.sh generates one; rotate by
# changing it here, restarting the service, and re-pasting the URL into the
# connector dialog.
MCP_AUTH_TOKEN=replace-me

# Second shared secret, for the reduced "presenter" MCP surface: the live
# teaching loop only (readme, create_session, create_questions, present_item,
# await_item_outcome, present_show, update_show, await_show_outcome,
# get_attempt, end_session, grade_response, list_ungraded_written). The tutor
# server gets this one and nothing else. install.sh generates it; leave it
# unset to turn the presenter surface off entirely. It must differ from
# MCP_AUTH_TOKEN — an identical value is refused at boot.
MCP_PRESENTER_TOKEN=replace-me

