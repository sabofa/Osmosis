# Local node — a device that holds downloaded tag slices, works offline, and
# syncs attempts up to the canonical server. deploy/install.sh (Linux, with
# OSMOSIS_ROLE=local) or deploy/install-local.ps1 (Windows) fills this in.
NODE_ROLE=local
NODE_LABEL=laptop
PORT=8081

# The canonical server, reachable over Tailscale. Cloud tests, daily draws and
# sync all go here; nothing else needs the network.
REMOTE_URL=http://100.86.89.59:8081

# Local state: the slice database and uploads. Absolute paths.
DB_PATH=/var/lib/osmosis/local.db
UPLOADS_DIR=/var/lib/osmosis/uploads

# Built web app, served by this node at http://localhost:8081/.
WEB_DIST_DIR=/opt/osmosis/web/dist
