{
  "name": "@osmosis/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:canonical": "tsx watch --env-file=.env.canonical src/index.ts",
    "dev:local": "tsx watch --env-file=.env.local src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:canonical": "node --env-file=.env.canonical dist/index.js",
    "start:local": "node --env-file=.env.local dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "document-engine": "*",
    "fastify": "^5.2.0",
    "graph-engine": "*",
    "pdfjs-dist": "^6.2.108",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
