# Shebang scripts must check out with LF regardless of local core.autocrlf
# settings — a CRLF shebang line breaks esbuild/vite's shebang-stripping
# (used by vitest to transform .mjs files under test), producing a
# SyntaxError at the following import line. Discovered when scripts/mcp-batch/
# cli.mjs (LF in the worktree it was authored in) checked out as CRLF in a
# different local checkout of the same commit.
*.mjs text eol=lf

# Deployment files are consumed by bash/systemd/cloudflared on Linux — a CRLF
# shebang or unit file breaks them outright.
*.sh text eol=lf
deploy/** text eol=lf
*.example text eol=lf
